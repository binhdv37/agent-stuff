{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "declaration": true,
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["core/src/**/*.ts", "tool/**/*.ts", "adapters/**/*.ts", "tests/**/*.ts"]
}
